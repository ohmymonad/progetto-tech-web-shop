# Copy this file to .env and fill in real values. .env is gitignored.

# --- Postgres (used by docker-compose db service and backend/config/database.yml) ---
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop_password
POSTGRES_DB=shop_development
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Rails backend ---
RAILS_MASTER_KEY=
DEVISE_JWT_SECRET_KEY=

# --- Frontend ---
# Base URL the Angular app uses to reach the Rails API
API_URL=http://localhost:3000
