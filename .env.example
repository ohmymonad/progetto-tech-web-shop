# Copy this file to .env and fill in real values. .env is gitignored.

# --- Postgres (used by docker-compose db service and backend/config/database.yml) ---
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop_password
POSTGRES_DB=shop_development
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Rails backend ---
# No RAILS_MASTER_KEY or DEVISE_JWT_SECRET_KEY here: secrets live in Rails encrypted
# credentials (backend/config/credentials.yml.enc), decrypted via the bind-mounted
# backend/config/master.key (never committed). See `rails credentials:edit`.

# --- Frontend ---
# Base URL the Angular app uses to reach the Rails API
API_URL=http://localhost:3000
